# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Path to the raw TWCS CSV (only needed the first time, to build data/processed/sample.csv)
# Leave blank to use the relative default: data/raw/twcs.csv
RAW_DATA_PATH=

# OpenAI API key (optional — enables LLM reply generation + LLM-as-judge)
# If not set, a deterministic local fallback is used automatically.
OPENAI_API_KEY=
